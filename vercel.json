{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/v1/health" },
    { "source": "/api/healthz", "destination": "/api/v1/health" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "x-release-channel", "value": "stable" }
      ]
    }
  ]
}
